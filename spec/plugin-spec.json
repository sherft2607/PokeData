{
  "plugin_name": "PokeData",
  "platform": "PokeAPI",
  "base_url": "https://pokeapi.co/api/v2",
  "auth_method": "none — public, unauthenticated API. No Auth subcategory, no Token/T input on any component, no ButtonComponent (no write actions to trigger). Phase 9 and Gate 5 will be skipped/auto-cleared for this build since there is nothing to authenticate.",
  "api_version": "v2 (spec dated 2022-05-23)",
  "tab_name": "PokeData",
  "subcategories": [
    {
      "name": "Pokemon",
      "type": "http",
      "components": [
        {
          "class_name": "GetPokemonComponent",
          "file_name": "GetPokemon.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": "pokemon_read",
          "workflow": "Base stat radar / parametric geometry driver",
          "inputs": [
            { "name": "Pokemon Name Or ID", "nickname": "P", "type": "string", "access": "item", "default": "" }
          ],
          "outputs": [
            { "name": "Types", "nickname": "TY", "type": "string", "access": "list" },
            { "name": "Height", "nickname": "H", "type": "number", "access": "item" },
            { "name": "Weight", "nickname": "W", "type": "number", "access": "item" },
            { "name": "Base Experience", "nickname": "BE", "type": "integer", "access": "item" },
            { "name": "Stat Names", "nickname": "SN", "type": "string", "access": "list" },
            { "name": "Stat Values", "nickname": "SV", "type": "integer", "access": "list" },
            { "name": "Sprite Front URL", "nickname": "SF", "type": "string", "access": "item" },
            { "name": "Sprite Artwork URL", "nickname": "SA", "type": "string", "access": "item" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" },
            { "name": "Legacy Cry URL", "nickname": "LC", "type": "string", "access": "item", "note": "extend-round-1: appended at the end, existing output indices unchanged" },
            { "name": "Latest Cry URL", "nickname": "LT", "type": "string", "access": "item", "note": "extend-round-1: appended at the end, existing output indices unchanged" }
          ]
        },
        {
          "class_name": "GetPokemonBatchComponent",
          "file_name": "GetPokemonBatch.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": "pokemon_read",
          "workflow": "Batch Pokedex table (tabular benchmark, read direction)",
          "note": "Same underlying endpoint as GetPokemon, called once per list item; outputs are tree-access, one branch per input item, positionally parallel to the input list",
          "inputs": [
            { "name": "Pokemon Names Or IDs", "nickname": "P", "type": "string", "access": "list", "default": "" }
          ],
          "outputs": [
            { "name": "Types", "nickname": "TY", "type": "string", "access": "tree" },
            { "name": "Height", "nickname": "H", "type": "number", "access": "tree" },
            { "name": "Weight", "nickname": "W", "type": "number", "access": "tree" },
            { "name": "Base Experience", "nickname": "BE", "type": "integer", "access": "tree" },
            { "name": "Stat Names", "nickname": "SN", "type": "string", "access": "tree" },
            { "name": "Stat Values", "nickname": "SV", "type": "integer", "access": "tree" },
            { "name": "Sprite Front URL", "nickname": "SF", "type": "string", "access": "tree" },
            { "name": "Sprite Artwork URL", "nickname": "SA", "type": "string", "access": "tree" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "tree" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "tree" }
          ]
        },
        {
          "class_name": "GetPokemonSpeciesComponent",
          "file_name": "GetPokemonSpecies.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": "pokemon-species_read",
          "workflow": "extend-round-1: species/flavor detail lookup, requested directly by the plugin author",
          "note": "Reuses the already-validated pokemon-species_read endpoint (same one GetEvolutionChain already calls internally) — no new extraction/testing needed this round.",
          "inputs": [
            { "name": "Species Name Or ID", "nickname": "SP", "type": "string", "access": "item", "default": "" }
          ],
          "outputs": [
            { "name": "Color", "nickname": "CO", "type": "string", "access": "item" },
            { "name": "Shape", "nickname": "SH", "type": "string", "access": "item" },
            { "name": "Habitat", "nickname": "HA", "type": "string", "access": "item" },
            { "name": "Capture Rate", "nickname": "CR", "type": "integer", "access": "item" },
            { "name": "Base Happiness", "nickname": "BH", "type": "integer", "access": "item" },
            { "name": "Growth Rate", "nickname": "GR", "type": "string", "access": "item" },
            { "name": "Egg Groups", "nickname": "EG", "type": "string", "access": "list" },
            { "name": "Is Legendary", "nickname": "IL", "type": "boolean", "access": "item" },
            { "name": "Is Mythical", "nickname": "IM", "type": "boolean", "access": "item" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" }
          ]
        },
        {
          "class_name": "SpriteDownloaderComponent",
          "file_name": "SpriteDownloader.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": null,
          "workflow": "extend-round-1: turns GetPokemon's sprite URL outputs into an actual image on the canvas for image samplers, requested directly by the plugin author",
          "note": "Not a PokeAPI endpoint — downloads arbitrary image bytes from a URL (sprites are hosted on raw.githubusercontent.com, not pokeapi.co) and decodes to a System.Drawing.Bitmap via a generic output param. No call-library entry; uses a new PokeDataClient.GetBytesAsync helper.",
          "inputs": [
            { "name": "Sprite URL", "nickname": "SU", "type": "string", "access": "item", "default": "" }
          ],
          "outputs": [
            { "name": "Bitmap", "nickname": "B", "type": "generic", "access": "item" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" }
          ]
        },
        {
          "class_name": "PokemonCryComponent",
          "file_name": "PokemonCry.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": "pokemon_read",
          "workflow": "v2.0.0: audio cries — hear a Pokemon's cry alongside its other data",
          "note": "Reuses pokemon_read (same endpoint as Get Pokemon) to read the cries.legacy/cries.latest URLs, then on trigger streams the audio bytes in-memory via PokeDataClient.GetImageBytesAsync and hands off to the OS default player through a transient temp file (no in-process .ogg decoder shipped).",
          "inputs": [
            { "name": "Pokemon Name Or ID", "nickname": "P", "type": "string", "access": "item", "default": "" },
            { "name": "Play", "nickname": "PL", "type": "boolean", "access": "item", "default": false }
          ],
          "outputs": [
            { "name": "Legacy Cry URL", "nickname": "LC", "type": "string", "access": "item" },
            { "name": "Latest Cry URL", "nickname": "LT", "type": "string", "access": "item" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" }
          ]
        },
        {
          "class_name": "BatchDownloaderComponent",
          "file_name": "BatchDownloader.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": null,
          "workflow": "v2.1.0: batch async image downloads — sprite/artwork URLs for many Pokemon at once",
          "note": "Not a PokeAPI endpoint — Task.WhenAll over the same PokeDataClient.GetImageBytesAsync helper Sprite Downloader uses (in-memory bytes, no disk locks), decoded per-URL to a Bitmap. Gated by Trigger so the URL list doesn't refetch on every solve.",
          "inputs": [
            { "name": "URLs", "nickname": "U", "type": "string", "access": "list", "default": "" },
            { "name": "Trigger", "nickname": "T", "type": "boolean", "access": "item", "default": false }
          ],
          "outputs": [
            { "name": "Bitmaps", "nickname": "B", "type": "generic", "access": "list" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" }
          ]
        }
      ]
    },
    {
      "name": "Types",
      "type": "http",
      "components": [
        {
          "class_name": "GetTypeComponent",
          "file_name": "GetType.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": "type_read",
          "workflow": "Type effectiveness matrix (granular primitive alongside the consolidated matrix component)",
          "inputs": [
            { "name": "Type Name", "nickname": "TN", "type": "string", "access": "item", "default": "" }
          ],
          "outputs": [
            { "name": "Double Damage To", "nickname": "DT", "type": "string", "access": "list" },
            { "name": "Double Damage From", "nickname": "DF", "type": "string", "access": "list" },
            { "name": "Half Damage To", "nickname": "HT", "type": "string", "access": "list" },
            { "name": "Half Damage From", "nickname": "HF", "type": "string", "access": "list" },
            { "name": "No Damage To", "nickname": "NT", "type": "string", "access": "list" },
            { "name": "No Damage From", "nickname": "NF", "type": "string", "access": "list" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" },
            { "name": "Associated Pokemon", "nickname": "AP", "type": "string", "access": "list", "note": "extend-round-1: appended at the end, existing output indices unchanged" },
            { "name": "Color", "nickname": "CO", "type": "colour", "access": "item", "note": "v2.0.0: appended at the end, existing output indices unchanged. Canonical elemental-type color (System.Drawing.Color via PluginUtilities.TypeColor) for viewport display pipelines." }
          ]
        },
        {
          "class_name": "TypeMatchupComponent",
          "file_name": "TypeMatchup.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": "type_read",
          "workflow": "v2.0.0: type matchups — what should I use against type X",
          "note": "Reuses type_read (same endpoint as Get Type); no new extraction/testing needed. Outputs only the outgoing (attacking) damage relations, split into 3 structured lists, as a focused counterpart to Get Type's full to/from set.",
          "inputs": [
            { "name": "Attacking Type", "nickname": "AT", "type": "string", "access": "item", "default": "" }
          ],
          "outputs": [
            { "name": "2x Damage To", "nickname": "DD", "type": "string", "access": "list" },
            { "name": "0.5x Damage To", "nickname": "HD", "type": "string", "access": "list" },
            { "name": "0x Damage To", "nickname": "ND", "type": "string", "access": "list" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" }
          ]
        },
        {
          "class_name": "GetTypeMatrixComponent",
          "file_name": "GetTypeMatrix.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": "type_read",
          "workflow": "Type effectiveness matrix (tabular benchmark, read direction)",
          "note": "Consolidated component: internally lists and fetches all 18 types, flattens damage_relations into one 18x18 cross product so the user gets the full matrix from a single placed component instead of wiring 18 GetType calls by hand",
          "inputs": [],
          "outputs": [
            { "name": "Attacking Type", "nickname": "AT", "type": "string", "access": "list" },
            { "name": "Defending Type", "nickname": "DT", "type": "string", "access": "list" },
            { "name": "Multiplier", "nickname": "M", "type": "number", "access": "list" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" }
          ]
        },
        {
          "class_name": "DualTypeMatchupComponent",
          "file_name": "DualTypeMatchup.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": "type_read",
          "workflow": "v2.1.0: dual-type defense — the real damage multiplier a two-type Pokemon takes, not just one type's own relations",
          "note": "Calls type_read once or twice (Type 2 optional) and multiplies each type's independent defensive multiplier per attacking type (PokeDataParsing.ComputeDualTypeDefense), bucketing into 4x/2x/1x/0.5x/0.25x/0x. No new extraction — reuses type_read.",
          "inputs": [
            { "name": "Type 1", "nickname": "T1", "type": "string", "access": "item", "default": "" },
            { "name": "Type 2", "nickname": "T2", "type": "string", "access": "item", "default": "" }
          ],
          "outputs": [
            { "name": "4x Damage From", "nickname": "X4", "type": "string", "access": "list" },
            { "name": "2x Damage From", "nickname": "X2", "type": "string", "access": "list" },
            { "name": "1x Damage From", "nickname": "X1", "type": "string", "access": "list" },
            { "name": "0.5x Damage From", "nickname": "H2", "type": "string", "access": "list" },
            { "name": "0.25x Damage From", "nickname": "H4", "type": "string", "access": "list" },
            { "name": "0x Damage From", "nickname": "X0", "type": "string", "access": "list" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" }
          ]
        }
      ]
    },
    {
      "name": "Evolution",
      "type": "http",
      "components": [
        {
          "class_name": "GetEvolutionChainComponent",
          "file_name": "GetEvolutionChain.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": "pokemon_species_read + evolution_chain_read",
          "workflow": "Evolution chain graph",
          "note": "Consolidated component: internally resolves species name -> evolution_chain URL -> fetches and flattens the chain, so the user does not have to chain a species lookup into a separate evolution-chain lookup by hand",
          "inputs": [
            { "name": "Species Name Or ID", "nickname": "SP", "type": "string", "access": "item", "default": "" }
          ],
          "outputs": [
            { "name": "Parent Species", "nickname": "P", "type": "string", "access": "list" },
            { "name": "Child Species", "nickname": "C", "type": "string", "access": "list" },
            { "name": "Trigger", "nickname": "TR", "type": "string", "access": "list" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" }
          ]
        }
      ]
    },
    {
      "name": "Moves",
      "type": "http",
      "components": [
        {
          "class_name": "GetMoveComponent",
          "file_name": "GetMove.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": "move_read",
          "workflow": "Move / ability lookup for team-building tools",
          "inputs": [
            { "name": "Move Name Or ID", "nickname": "M", "type": "string", "access": "item", "default": "" }
          ],
          "outputs": [
            { "name": "Power", "nickname": "P", "type": "integer", "access": "item" },
            { "name": "Accuracy", "nickname": "A", "type": "integer", "access": "item" },
            { "name": "PP", "nickname": "PP", "type": "integer", "access": "item" },
            { "name": "Damage Class", "nickname": "DC", "type": "string", "access": "item" },
            { "name": "Type", "nickname": "T", "type": "string", "access": "item" },
            { "name": "Effect Text", "nickname": "E", "type": "string", "access": "item" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" },
            { "name": "Priority", "nickname": "PR", "type": "integer", "access": "item", "note": "v2.0.0: appended at the end, existing output indices unchanged" },
            { "name": "Description", "nickname": "D", "type": "string", "access": "list", "note": "v2.0.0: appended at the end, existing output indices unchanged. One flavor_text_entries description per distinct language." }
          ]
        },
        {
          "class_name": "GetAbilityComponent",
          "file_name": "GetAbility.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": "ability_read",
          "workflow": "Move / ability lookup for team-building tools",
          "inputs": [
            { "name": "Ability Name Or ID", "nickname": "A", "type": "string", "access": "item", "default": "" }
          ],
          "outputs": [
            { "name": "Generation", "nickname": "G", "type": "string", "access": "item" },
            { "name": "Effect Text", "nickname": "E", "type": "string", "access": "item" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" },
            { "name": "Short Effect", "nickname": "SE", "type": "string", "access": "list", "note": "v2.0.0: appended at the end, existing output indices unchanged. One effect_entries short_effect per distinct language." }
          ]
        }
      ]
    },
    {
      "name": "Items",
      "type": "http",
      "components": [
        {
          "class_name": "GetItemComponent",
          "file_name": "GetItem.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": "item_read",
          "workflow": "v2.1.0: item lookup — category, cost, fling power, effect text, sprite for team/bag-planning tools",
          "inputs": [
            { "name": "Item Name Or ID", "nickname": "I", "type": "string", "access": "item", "default": "" }
          ],
          "outputs": [
            { "name": "Category", "nickname": "C", "type": "string", "access": "item" },
            { "name": "Cost", "nickname": "CO", "type": "integer", "access": "item" },
            { "name": "Fling Power", "nickname": "FP", "type": "integer", "access": "item" },
            { "name": "Effect Text", "nickname": "E", "type": "string", "access": "item" },
            { "name": "Sprite URL", "nickname": "SP", "type": "string", "access": "item" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" }
          ]
        }
      ]
    },
    {
      "name": "Stats",
      "type": "http",
      "components": [
        {
          "class_name": "GetNatureComponent",
          "file_name": "GetNature.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": "nature_read",
          "workflow": "v2.1.0: nature lookup — +10%/-10% stat modifiers and berry-flavor preferences for breeding/EV-planning tools",
          "note": "increased_stat/decreased_stat/likes_flavor/hates_flavor are JSON null for neutral natures (e.g. hardy) — SafeString returns \"\" rather than erroring.",
          "inputs": [
            { "name": "Nature Name Or ID", "nickname": "N", "type": "string", "access": "item", "default": "" }
          ],
          "outputs": [
            { "name": "Increased Stat", "nickname": "IS", "type": "string", "access": "item" },
            { "name": "Decreased Stat", "nickname": "DS", "type": "string", "access": "item" },
            { "name": "Liked Flavor", "nickname": "LF", "type": "string", "access": "item" },
            { "name": "Disliked Flavor", "nickname": "DF", "type": "string", "access": "item" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" }
          ]
        }
      ]
    },
    {
      "name": "Data",
      "type": "http",
      "components": [
        {
          "class_name": "GetGenerationComponent",
          "file_name": "GetGeneration.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": "generation_read",
          "workflow": "v2.1.0: generation roster — every species ID/name introduced in a given generation, for generation-scoped tools",
          "inputs": [
            { "name": "Generation", "nickname": "G", "type": "integer", "access": "item", "default": 1 }
          ],
          "outputs": [
            { "name": "Species IDs", "nickname": "SI", "type": "integer", "access": "list" },
            { "name": "Species Names", "nickname": "SN", "type": "string", "access": "list" },
            { "name": "Region", "nickname": "R", "type": "string", "access": "item" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "RS", "type": "string", "access": "item" }
          ]
        },
        {
          "class_name": "PokemonFilterComponent",
          "file_name": "PokemonFilter.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": null,
          "workflow": "v2.1.0: filtering a Pokedex-scale list down to matches (e.g. stat total in range) without hand-wiring native GH list filters",
          "note": "Not a PokeAPI endpoint — pure list filtering (PokeDataParsing.FilterByRule) over two parallel lists the user already has on the canvas (e.g. Get Pokemon Batch's names + a computed stat total); Filter Rule is one of GreaterThan/LessThan/Between/Equals.",
          "inputs": [
            { "name": "Names", "nickname": "N", "type": "string", "access": "list", "default": "" },
            { "name": "Values", "nickname": "V", "type": "number", "access": "list", "default": "" },
            { "name": "Filter Rule", "nickname": "FR", "type": "string", "access": "item", "default": "Between" },
            { "name": "Min", "nickname": "MN", "type": "number", "access": "item", "default": 0.0 },
            { "name": "Max", "nickname": "MX", "type": "number", "access": "item", "default": 999999.0 }
          ],
          "outputs": [
            { "name": "Filtered Names", "nickname": "FN", "type": "string", "access": "list" },
            { "name": "Filtered Values", "nickname": "FV", "type": "number", "access": "list" },
            { "name": "Match Indices", "nickname": "MI", "type": "integer", "access": "list" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" }
          ]
        }
      ]
    },
    {
      "name": "Geometry",
      "type": "util",
      "components": [
        {
          "class_name": "PokemonDimensionsComponent",
          "file_name": "PokemonDimensions.cs",
          "type": "component",
          "role": "unit",
          "endpoint_id": null,
          "workflow": "v2.1.0: real-world scale reference — turning PokeAPI's raw decimetre/hectogram fields into a placeable Box",
          "note": "Not a PokeAPI endpoint — pure unit conversion (PokeDataParsing.ConvertDimensions) plus a Rhino Box sized to the converted height, footprint proportional to height.",
          "inputs": [
            { "name": "Height", "nickname": "H", "type": "number", "access": "item", "default": 0.0 },
            { "name": "Weight", "nickname": "W", "type": "number", "access": "item", "default": 0.0 },
            { "name": "Plane", "nickname": "PL", "type": "plane", "access": "item", "default": "WorldXY" }
          ],
          "outputs": [
            { "name": "Height (m)", "nickname": "HM", "type": "number", "access": "item" },
            { "name": "Height (ft)", "nickname": "HF", "type": "number", "access": "item" },
            { "name": "Weight (kg)", "nickname": "WK", "type": "number", "access": "item" },
            { "name": "Weight (lb)", "nickname": "WL", "type": "number", "access": "item" },
            { "name": "Reference Box", "nickname": "BX", "type": "box", "access": "item" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" }
          ]
        }
      ]
    },
    {
      "name": "Visualization",
      "type": "util",
      "components": [
        {
